venv/
.venv/

__pycache__/
*.py[cod]
.pytest_cache/

build/
dist/
*.egg-info/
game-settings-default.cs

# Generated training artefacts.
logs/
models/*
models/*.zip
!models/.gitkeep

# Large local media sources. Commit only small, deliberate README assets.
assets/*.mp4
assets/*.mov
assets/*.mkv
assets/*-palette.png

# Scratch workdir for scripts/vehicle_viewer/ -- extracted BeamNG game
# assets (not ours to redistribute) plus generated GLB/render output.
# Regenerate via scripts/vehicle_viewer/README.md.
scratch_vehicle_extract/

# Hero-viewer GLB models -- same reason as above: derived from BeamNG's
# own licensed assets, not ours to commit. The launcher's Garage tab
# checks whether each one exists on disk and shows "coming soon" if not
# (scripts/launcher/app.py's /api/vehicle/<car>/viewer), so a clone
# without these just degrades gracefully instead of breaking.
scripts/launcher/static/models/*.glb

# Local/editor/machine state.
.claude/
.vscode/
settings/
BeamNG.tech.ini
env.env
